@@ -0,0 +1,30 @@
+use {
+    crate::{admin_rpc_service, cli::DefaultArgs, commands::Result},
+    clap::{App, Arg, ArgMatches, SubCommand, value_t_or_exit},
+    std::path::Path,
+};
+
+pub fn command(_default_args: &DefaultArgs) -> App<'_, '_> {
+    SubCommand::with_name("set-tpu-proxy-addresses")
+        .about("Set TPU proxy addresses for forwarding incoming transactions via UDP")
+        .arg(
+            Arg::with_name("tpu_proxy_address")
+                .long("tpu-proxy-address")
+                .value_name("TPU_PROXY_ADDRESS")
+                .takes_value(true)
+                .help(
+                    "Comma-separated list of ip:port addresses to proxy TPU transactions to via \
+                     UDP. Each incoming non-vote transaction will be sent as a raw UDP datagram to \
+                     all specified addresses. Set to empty string to disable proxying.",
+                )
+                .required(true),
+        )
+}
+
+pub fn execute(subcommand_matches: &ArgMatches, ledger_path: &Path) -> Result<()> {
+    let addrs = value_t_or_exit!(subcommand_matches, "tpu_proxy_address", String);
+    let admin_client = admin_rpc_service::connect(ledger_path);
+    admin_rpc_service::runtime()
+        .block_on(async move { admin_client.await?.set_tpu_proxy_addresses(addrs).await })?;
+    Ok(())
+}
