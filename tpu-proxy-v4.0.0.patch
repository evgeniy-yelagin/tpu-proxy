+                            ))
+                        })
+                })
+                .collect::<Result<Vec<_>>>()?
+        };
+        info!("Setting TPU proxy addresses: {:?}", parsed);
+        meta.with_post_init(|post_init| {
+            post_init
+                .tpu_proxy_addresses
+                .store(Arc::new(parsed));
+            Ok(())
+        })
+    }
