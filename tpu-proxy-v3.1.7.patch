diff --git a/core/src/proxy/tpu_transaction_proxy.rs b/core/src/proxy/tpu_transaction_proxy.rs
new file mode 100644
index 0000000000..c55fc324a6
--- /dev/null
+++ b/core/src/proxy/tpu_transaction_proxy.rs
@@ -0,0 +1,72 @@
+use {
+    arc_swap::ArcSwap,
+    solana_gossip::cluster_info::ClusterInfo,
+    solana_perf::packet::PacketBatch,
+    std::{
+        net::{SocketAddr, UdpSocket},
+        sync::Arc,
+    },
+};
+
+/// Max serialized transaction (1232) + 32-byte validator identity.
+const MAX_PROXY_DATAGRAM: usize = 1264;
+
+/// Smallest valid Solana transaction: 1 (num_sigs) + 64 (sig) + 3 (header)
+/// + 1 (num_accounts) + 32 (account) + 32 (blockhash) + 1 (num_instructions).
+const MIN_TRANSACTION_SIZE: usize = 134;
+
+/// Fire-and-forget UDP proxy for incoming TPU transactions.
+/// Appends the validator's 32-byte identity pubkey to each datagram
+/// so the receiving side can identify the source validator.
+/// Identity is read from ClusterInfo on every batch to reflect runtime changes.
+pub struct TpuTransactionProxy {
+    socket: UdpSocket,
+    targets: Arc<ArcSwap<Vec<SocketAddr>>>,
+    cluster_info: Arc<ClusterInfo>,
+}
+
+impl TpuTransactionProxy {
+    pub fn new(targets: Arc<ArcSwap<Vec<SocketAddr>>>, cluster_info: Arc<ClusterInfo>) -> Self {
+        let socket = UdpSocket::bind("0.0.0.0:0").expect("bind proxy UDP socket");
+        socket
+            .set_nonblocking(true)
+            .expect("set proxy UDP socket non-blocking");
+        Self {
+            socket,
+            targets,
+            cluster_info,
+        }
+    }
+
+    /// Proxy every non-discarded packet across all batches to configured targets.
+    /// Loads identity and target list once per call to avoid repeated atomic ops.
+    /// Each datagram = raw transaction bytes ++ 32-byte validator identity.
+    /// Silently drops on send errors (non-blocking).
+    pub fn proxy_packet_batches(&self, batches: &[PacketBatch]) {
+        let targets = self.targets.load();
+        if targets.is_empty() {
+            return;
+        }
+        let identity = self.cluster_info.id().to_bytes();
+        let mut buf = [0u8; MAX_PROXY_DATAGRAM];
+        for pkt in batches {
+            for packet in pkt.iter() {
+                if packet.meta().discard() {
+                    continue;
+                }
+                let size = packet.meta().size;
+                if size < MIN_TRANSACTION_SIZE || size + 32 > MAX_PROXY_DATAGRAM {
+                    continue;
+                }
+                if let Some(data) = packet.data(..size) {
+                    let total = size + 32;
+                    buf[..size].copy_from_slice(data);
+                    buf[size..total].copy_from_slice(&identity);
+                    for target in targets.iter() {
+                        let _ = self.socket.send_to(&buf[..total], target);
+                    }
+                }
+            }
+        }
+    }
+}
